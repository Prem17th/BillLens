# =============================================================================
# BillLens Environment Configuration
# =============================================================================

# Server Port (Render and local development)
PORT=8080

# ArmorIQ Agent Security SDK (Optional - fallback cryptographic mode enabled if omitted)
# Get your API key from https://armoriq.ai
ARMORIQ_API_KEY=your_armoriq_api_key_here

# OpenAI API Key (Optional - for live GPT-4o-mini underwriting memorandum generation)
# Fallback pre-calculated audit memorandum is automatically used if omitted
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional - for alternative live Gemini underwriting)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Voice API (Optional - for live multi-lingual TTS voice telemetry)
# Bundled studio master audio briefs (Kannada/Hindi/English) are used if omitted
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Geoapify API Key (Optional - for Bangalore Mandi spatial radar tiles & geocoding)
# Standard OpenStreetMap tile fallback is automatically used if omitted
GEOAPIFY_API_KEY=your_geoapify_api_key_here
